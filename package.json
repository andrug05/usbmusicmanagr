{
  "name": "oap-usb-music-manager",
  "version": "0.1.15",
  "description": "USB music manager with ID3 editing, reversible trash and AcoustID auto recognition",
  "main": "javascript/runner.js",
  "productName": "USB Music Manager",
  "author": "AndruG05",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "mguLocalOnly": true,
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 35,
    "memoryThresholdKB": 131072,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "UMM1",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "startUpGroups": [
      909
    ]
  },
  "files": [
    "package.json",
    "component.json",
    "manifest.json",
    "index.html",
    "css",
    "javascript",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=8.16.0"
  }
}
